# Copy to .env and fill in. Never commit real values.

# --- Gemini (server only) ---
GEMINI_API_KEY=

# --- PostgreSQL ---
# Used by docker compose. Change it before running on a real server.
POSTGRES_PASSWORD=vitalis
# Only needed when running the server outside docker compose (npm run dev:api):
DATABASE_URL=postgres://vitalis:vitalis@localhost:5432/vitalis

# --- Firebase web app config (public; served to the browser by /api/auth-config) ---
# Firebase console > Project settings > General > Your apps > Web app > SDK config
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=

# --- Firebase Admin (server only, SECRET) ---
# Firebase console > Project settings > Service accounts > Generate new private key.
# Use ONE of: a path to the JSON file, or the JSON itself (raw or base64).
# Without it, sign-in still works but the admin panel / role changes are disabled.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT=

# --- Authorization ---
# Comma-separated emails promoted to admin on their first (verified) sign-in.
ADMIN_EMAILS=
# true = email/password users must verify their email before using the API.
REQUIRE_EMAIL_VERIFIED=false

# --- Split deployment (frontend on Vercel, API on Render) ---
# Backend: comma-separated origins allowed to call the API from a browser.
# Leave empty when the frontend and API share one origin (Docker / local dev).
# A "*" may stand for a subdomain fragment, e.g. https://vitalis-*.vercel.app
CORS_ORIGINS=
# Frontend (set in Vercel, used at build time): the API's public URL.
# Leave empty locally — Vite proxies /api to the backend.
VITE_API_URL=

# --- One-off data copy (scripts/copy-db.mjs) ---
# Target database for copying local data to Neon. Direct (non -pooler) URL.
NEON_DATABASE_URL=
