# Copy to .env.local and fill in. Never commit real values.

# --- Gemini (server only) ---
GEMINI_API_KEY=

# --- PostgreSQL (server only, SECRET) ---
# Local docker-compose: postgres://vitalis:vitalis@localhost:5432/vitalis
# Managed (Neon/Supabase/Render/Railway): paste the URL they give you.
DATABASE_URL=postgres://vitalis:vitalis@localhost:5432/vitalis
# Leave empty to follow the URL (?sslmode=require). "true" = TLS verified,
# "no-verify" = TLS with self-signed certs, "false" = no TLS.
DATABASE_SSL=

# --- Firebase web app config (public; served to the browser by /api/auth-config) ---
# Firebase console > Project settings > General > Your apps > Web app > SDK config
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=

# --- Firebase Admin (server only, SECRET) ---
# Firebase console > Project settings > Service accounts > Generate new private key.
# Use ONE of: a path to the JSON file, or the JSON itself (raw or base64).
# Without it, sign-in still works but the admin panel / role changes are disabled.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT=

# --- Authorization ---
# Comma-separated emails promoted to admin on their first (verified) sign-in.
ADMIN_EMAILS=
# true = email/password users must verify their email before using the API.
REQUIRE_EMAIL_VERIFIED=false
